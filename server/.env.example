NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/canteen
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=canteen_token
# lax works when the client and API share the same site/origin (recommended).
# Set to 'none' only if the frontend and API are deployed on different origins
# (this forces the Secure flag on and requires HTTPS).
COOKIE_SAME_SITE=lax
CLIENT_ORIGIN=http://localhost:5173
